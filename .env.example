# Copy to .env for local development. Never commit .env.
# On Render set these in Environment, not in a committed file.
APP_ENV=development

# Copy project URL and a server-only secret key from Supabase.
# Leave both blank to view the existing data locally in read-only preview.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Local preview is disabled automatically in production / on Render.
APP_PREVIEW_MODE=true

# Optional source directories for local preview and legacy image links:
# APP_PREVIEW_DATA_DIR=D:/path/to/data
# APP_UPLOAD_DIR=D:/path/to/uploads
